# --- backend
PM_ENV=dev
PM_DATABASE_URL=sqlite:///./var/provamusteri.sqlite3
PM_MEDIA_DIR=./var/media
PM_CORS_ORIGINS=["http://localhost:5173"]
PM_COOKIE_SECURE=false
PM_MAX_AUDIO_BYTES=10485760
PM_MAX_AUDIO_SECONDS=30
# Seed şifresi (dev'de boşsa "prova1234")
PM_DEMO_PASSWORD=

# --- model
# real: model-service'e HTTP. stub yalnız GPU'suz test içindir.
PM_MODEL_MODE=real
PM_MODEL_SERVICE_URL=http://localhost:8100
PM_EVAL_TEMPERATURE=1.0

# --- model-service (uvicorn --env-file ../.env ile okunur)
# Apple Silicon: mlx + 4-bit E4B. NVIDIA: PM_RUNTIME=transformers, PM_MODEL_ID=google/gemma-4-E4B-it
PM_RUNTIME=mlx
PM_MODEL_ID=mlx-community/gemma-4-e4b-it-4bit
# PM_DEVICE=cuda   # yalnız transformers; boşsa otomatik: cuda > mps > cpu
# Windows yazılı prova: PM_RUNTIME=ollama, PM_MODEL_ID=gemma4:e2b (bkz. model-service/README.md)
# PM_OLLAMA_URL=http://127.0.0.1:11434
# PM_OLLAMA_CONTEXT_LENGTH=8192
# PM_MODEL_TIMEOUT_S=600

# --- TTS: piper = yerel ONNX ses, local = macOS `say`, none = tur sesi yok
PM_TTS_PROVIDER=local
PM_TTS_VOICE=Yelda
PM_TTS_VOICE_MALE=Cem
# Windows/Linux yerel Türkçe ses: PM_TTS_PROVIDER=piper; pip install -e ".[tts]"
# PM_TTS_MODEL_PATH=D:/hck/tools/piper/tr_TR-dfki-medium.onnx
